# ==============================================================================
# C++ / CMake / Emscripten Project .gitignore
# ==============================================================================

# Build directories
build/
build-*/
bin/
wasm/
lib/
dist/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
_deps/
*.cmake.in

# Compiled Object files
*.o
*.obj
*.ko
*.elf

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.so.*
*.dylib
*.dll

# Compiled Static libraries
*.a
*.lib
*.lai
*.la
*.lo

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Emscripten / WebAssembly files
*.wasm
*.js.mem
*.bc
*.wast
*.wat

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Profiling data
*.gcda
*.gcno
*.gcov
gmon.out

# Core dumps
core
core.*

# ==============================================================================
