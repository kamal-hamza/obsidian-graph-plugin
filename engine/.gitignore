# ==============================================================================

Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ==============================================================================
# Temporary and cache files
# ==============================================================================

*.tmp
*.temp
*.cache
*.log
*.bak
*.old
*.orig

# Node modules (if using npm for tooling)
node_modules/
package-lock.json
yarn.lock

# Python (if using any Python scripts)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# ==============================================================================
# Project specific
# ==============================================================================

# Backup of Makefile (since we migrated to CMake)
Makefile.bak

# Test outputs
test_output/
*.test

# Documentation builds
docs/_build/
docs/.buildinfo

# Coverage reports
coverage/
*.coverage
htmlcov/

# Benchmark results
benchmarks/results/

# Emscripten cache
.emscripten_cache/
.emscripten_ports/
.emscripten_sanity

# Compile commands database (this gets regenerated)
# Note: You might want to keep this for LSP/clangd
# compile_commands.json

# But ignore backup copies
compile_commands.json.bak