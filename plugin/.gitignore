# ==============================================================================
# Obsidian Plugin .gitignore
# ==============================================================================

# Compiled output
main.js
*.js.map
styles.css

# Generated WASM files (built from C++ engine)
math_engine.js
src/wasm/math_engine.js

# Node modules
node_modules/

# Build directories
dist/
build/
.esbuild/

# Dependency lock files (keep package.json but ignore locks)
package-lock.json
yarn.lock
pnpm-lock.yaml

# TypeScript cache
*.tsbuildinfo

# Testing
coverage/
.nyc_output/

# Environment variables
.env
.env.local
.env.*.local

# ==============================================================================
# IDE / Editor
# ==============================================================================

# Visual Studio Code
.vscode/
*.code-workspace
.history/

# JetBrains IDEs
.idea/
*.iml

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# ==============================================================================
# OS specific
# ==============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# ==============================================================================
# Logs and temporary files
# ==============================================================================

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Temporary files
*.tmp
*.temp
*.bak
*.old
*.orig

# ==============================================================================
# Plugin development
# ==============================================================================

# Hot reload plugin (if using)
.hotreload

# Test vault
test-vault/
.obsidian/

# Release artifacts (these get generated)
# Uncomment if you want to ignore release files
# releases/